# ============================================================
#  Research Paper Generator — API Key Configuration
#  Copy this file to .env and fill in at least one key.
#  The script auto-detects the provider from available keys.
# ============================================================

# ── Anthropic (Paid) ─────────────────────────────────────────
# Get key: https://console.anthropic.com/settings/keys
# Default model: claude-opus-4-8
ANTHROPIC_API_KEY=

# ── Google Gemini (FREE tier) ─────────────────────────────────
# Get key: https://aistudio.google.com/app/apikey
# Free limits: 15 req/min, 1 M tokens/day (Gemini 2.0 Flash)
# Default model: gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key_here

# ── Groq (FREE tier) ─────────────────────────────────────────
# Get key: https://console.groq.com/keys
# Free limits: 30 req/min, 14 400 req/day (Llama 3.3 70B)
# Default model: llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here

# ── Together AI (FREE $1 credit on signup) ────────────────────
# Get key: https://api.together.xyz/settings/api-keys
# Default model: meta-llama/Llama-3.3-70B-Instruct-Turbo
TOGETHER_API_KEY=
